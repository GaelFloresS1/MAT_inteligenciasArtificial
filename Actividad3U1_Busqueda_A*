        static Estado AEstrella(string inicio, string objetivo)
        {
            List<Estado> abiertos = new List<Estado>();
            HashSet<string> cerrados = new HashSet<string>();

            // Crear estado inicial
            Estado inicial = new Estado(
                inicio,
                0,
                heuristica[inicio],
                null
            );

            abiertos.Add(inicial);

            while (abiertos.Count > 0)
            {
                Estado actual = abiertos[0];

                for (int i = 1; i < abiertos.Count; i++)
                {
                    if (abiertos[i].F < actual.F)
                    {
                        actual = abiertos[i];
                    }
                }

                Console.WriteLine("\n================================");
                Console.WriteLine("Ciudad investigada: " + actual.Ciudad);
                Console.WriteLine("G = " + actual.G);
                Console.WriteLine("H = " + actual.H);
                Console.WriteLine("F = " + actual.F);
                Console.WriteLine("================================");

                // ¿Llegamos al destino?
                if (actual.Ciudad == objetivo)
                {
                    return actual;
                }
                // Pasar de OPEN a CLOSED
                abiertos.Remove(actual);
                cerrados.Add(actual.Ciudad);

                // Revisar vecinos
                foreach (var vecino in mapa[actual.Ciudad])
                {
                    // Si ya fue explorado, ignorarlo
                    if (cerrados.Contains(vecino.Key))
                    {
                        continue;
                    }

                    // Calcular nuevo costo G
                    int nuevoG = actual.G + vecino.Value;

                    // Buscar si ya está en OPEN
                    Estado existente = abiertos.Find(
                        e => e.Ciudad == vecino.Key
                    );

                    // Si no está en OPEN
                    if (existente == null)
                    {
                        int nuevoH = heuristica[vecino.Key];

                        Estado nuevoEstado = new Estado(
                            vecino.Key,
                            nuevoG,
                            nuevoH,
                            actual
                        );

                        abiertos.Add(nuevoEstado);
                    }
                    // Si ya está en OPEN
                    else if (nuevoG < existente.G)
                    {
                        existente.G = nuevoG;
                        existente.F = existente.G + existente.H;
                        existente.Padre = actual;
                    }
                }
            }
            return null;
        }
